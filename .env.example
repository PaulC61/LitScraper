# LLM backend selection. This project is Qwen-centric and self-configures by
# default: "auto" picks a local Ollama Qwen3 model on a machine with a large
# GPU (e.g. an H100/H200 server), or Alibaba's hosted Qwen API (DashScope)
# otherwise (e.g. a MacBook). Set explicitly to "ollama", "dashscope", or
# "deepseek" to force a specific backend regardless of hardware.
LITSCRAPER_LLM_PROVIDER=auto

# On a shared multi-GPU server (e.g. an 8x H100/H200 box, GPUs 0-7), pin
# which GPU(s) this run should use for hardware detection/model-sizing.
# Comma-separated indices, e.g. "3" or "2,3". Falls back to the standard
# CUDA_VISIBLE_DEVICES if that's already set. Leave blank to use/detect all
# visible GPUs. NOTE: this only affects detection/sizing here - also export
# the same value as CUDA_VISIBLE_DEVICES before running `ollama serve` so
# Ollama itself is pinned to the same GPU(s).
LITSCRAPER_GPU_DEVICE=

# --- Alibaba DashScope / Qwen API (used on machines with no large GPU, e.g.
# a personal MacBook) ---
# Get a key from https://bailian.console.alibabacloud.com/ (Model Studio ->
# API-KEY), then paste it below. This is the ONLY line most Mac users need
# to fill in.
DASHSCOPE_API_KEY=sk-...
# If your Alibaba Cloud account is mainland-China-based, use the CN endpoint
# instead: https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LITSCRAPER_DASHSCOPE_MODEL=qwen3-235b-a22b

# --- Ollama (used automatically on a big-GPU machine, e.g. H100/H200) ---
# Leave LITSCRAPER_OLLAMA_MODEL unset to auto-size the Qwen3 tag to the
# detected GPU memory; set it to pin a specific tag instead.
OLLAMA_BASE_URL=http://localhost:11434/v1
# The .devcontainer image has Ollama installed, so `ollama serve` inside the
# container works with the default localhost URL above. Only switch to
# host.docker.internal if you instead run `ollama serve` on the host:
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
LITSCRAPER_OLLAMA_MODEL=
OLLAMA_API_KEY=ollama

# --- DeepSeek (legacy/alternative hosted backend; set LITSCRAPER_LLM_PROVIDER=deepseek to use) ---
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
LITSCRAPER_DEEPSEEK_MODEL=deepseek-chat

# Increase this only when a paper's complete structured output exceeds 16K.
LITSCRAPER_MAX_OUTPUT_TOKENS=16384
# Schema-validation retries (instructor re-prompts the model).
LITSCRAPER_LLM_MAX_RETRIES=3
# Per-request wall-clock budget in seconds. Raise if long papers on a slow
# local model produce "Request timed out." errors.
LITSCRAPER_LLM_TIMEOUT_S=1800
# Transport-level retries inside the OpenAI SDK (connection resets, 429/5xx).
LITSCRAPER_LLM_TRANSPORT_RETRIES=3
# Extra whole-request retries on timeouts/connection errors, with exponential
# backoff starting at LITSCRAPER_LLM_RETRY_BACKOFF_S seconds.
LITSCRAPER_LLM_TIMEOUT_RETRIES=3
LITSCRAPER_LLM_RETRY_BACKOFF_S=15
GROBID_URL=http://localhost:8070
# Inside the .devcontainer, GROBID runs as a sibling container on the host:
# GROBID_URL=http://host.docker.internal:8070
GROBID_TIMEOUT_S=180
LITSCRAPER_VERIFY=true
LITSCRAPER_BATCH_ASSESS=true
